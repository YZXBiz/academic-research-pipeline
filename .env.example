# Academic Pipeline — Environment Variables
# Copy this file: cp .env.example .env
# Only ANTHROPIC_API_KEY, OPENAI_API_KEY, and EXA_API_KEY are required.
# Everything else has sensible defaults.

# ── API Keys (required) ──────────────────────────────────
# All pipeline agents now route through dpapi.cn's OpenAI-compatible proxy
# (DeepSeek + Claude relay). The Anthropic SDK does NOT work against this proxy.
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://dpapi.cn/v1
# Exa neural search key for bibliography and dataset discovery
EXA_API_KEY=exa-...

# ── API Keys (optional) ──────────────────────────────────
# Semantic Scholar API key for paper metadata lookups
# S2_API_KEY=

# ── Model Selection ──────────────────────────────────────
# Primary model used by all pipeline agents (DeepSeek v4 pro with reasoning + web search)
# MODEL_NAME=deepseek-v4-pro-reasoner-search
# Independent verifier model (same proxy; switch to a different provider for true cross-model checking)
# INDEPENDENT_VERIFIER_MODEL=openai:deepseek-v4-pro-reasoner-search

# ── Quality / Evaluation ────────────────────────────────
# Thinking effort level: max, high, medium, low
# EFFORT=max
# Temperature for research/integrity agents (0.0-1.0)
# TEMPERATURE_RESEARCH=0.3
# Temperature for writing agents (0.0-1.0)
# TEMPERATURE_WRITING=0.5
# Temperature for review agents (0.0-1.0)
# TEMPERATURE_REVIEW=0.3
# Enable per-node multi-model evaluator-optimizer loop
# ENABLE_NODE_EVALUATION=true
# Comma-separated list of models used for per-node evaluation
# EVALUATOR_MODELS=["openai:deepseek-v4-pro-reasoner-search"]
# Max optimizer iterations per node before accepting output
# MAX_NODE_ITERATIONS=2
# Minimum quality score (0-10) to pass a node without re-optimization
# NODE_QUALITY_THRESHOLD=7.0
# Enable compliance check on final output
# ENABLE_COMPLIANCE_CHECK=true
# Max integrity fix loops before giving up
# MAX_INTEGRITY_FIX_LOOPS=3
# Token count at which context compaction triggers
# COMPACTION_TOKEN_THRESHOLD=800000

# ── Experiments ──────────────────────────────────────────
# Enable the experiment subgraph (design, codegen, execute, analyze)
# EXPERIMENT_ENABLED=true
# Force experiments even when the classifier says none needed
# FORCE_EXPERIMENT=false
# Max seconds before experiment execution is killed
# EXPERIMENT_TIMEOUT_SECONDS=1800
# Max retries for failed experiment runs
# EXPERIMENT_MAX_RETRIES=3
# Max improvement iterations per experiment
# EXPERIMENT_MAX_IMPROVEMENTS=2
# Seeds for multi-seed replication (JSON list)
# EXPERIMENT_SEEDS=[42,123,456]
# Allowed Python packages in experiment sandbox (JSON list)
# EXPERIMENT_ALLOWED_PACKAGES=["pandas","numpy","sklearn","scikit-learn","xgboost","lightgbm","matplotlib","seaborn","scipy","statsmodels","ucimlrepo","datasets","requests","catboost","shap","scikit-posthocs","duckdb","autogluon","gluonts","statsforecast","chronos","transformers","timm","mmdet","mmcv"]
# Local path to a pre-downloaded dataset (skips discovery)
# EXPERIMENT_DATASET_PATH=

# ── Docker ───────────────────────────────────────────────
# Run experiment code inside Docker (falls back to subprocess if false)
# EXPERIMENT_USE_DOCKER=true
# Docker image for the experiment sandbox
# EXPERIMENT_DOCKER_IMAGE=academic-pipeline-sandbox:latest
# Memory limit for the Docker container
# EXPERIMENT_DOCKER_MEMORY=4g
# CPU limit for the Docker container
# EXPERIMENT_DOCKER_CPUS=2
# Pass API keys into the Docker container (disable for untrusted code)
# EXPERIMENT_DOCKER_PASS_API_KEYS=false

# ── Email Alerts ─────────────────────────────────────────
# Email address to notify when dataset discovery fails
# EXPERIMENT_ALERT_EMAIL=
# Sender address for alert emails
# EXPERIMENT_ALERT_SENDER=
# SMTP server hostname
# EXPERIMENT_SMTP_SERVER=
# SMTP server port
# EXPERIMENT_SMTP_PORT=25

# ── Rate Limiting ────────────────────────────────────────
# Delay in seconds between tool calls (0 = no delay, default 10)
TOOL_CALL_DELAY_SECONDS=0

# ── Checkpointing ───────────────────────────────────────
# State persistence backend: memory, sqlite, postgres
# CHECKPOINTER_BACKEND=sqlite
# PostgreSQL connection URL (required when backend is postgres)
# DATABASE_URL=
# Path to the SQLite checkpoint database file
# SQLITE_PATH=~/.academic_pipeline/checkpoints.db

# ── Resume Limits ────────────────────────────────────────
# Max times the top-level pipeline graph can resume after crash
# MAX_PIPELINE_RESUMES=50
# Max times a subgraph can resume after crash
# MAX_SUBGRAPH_RESUMES=20

# ── Network / HTTP ───────────────────────────────────────
# Verify SSL certificates (disable for corporate proxies like Zscaler)
# SSL_VERIFY=true
# Timeout in seconds for HTTP tool calls (DOI, Semantic Scholar, etc.)
# HTTP_TIMEOUT_SECONDS=20
# Max retries for failed HTTP requests
# HTTP_MAX_RETRIES=3
# Exponential backoff base in seconds for HTTP retries
# HTTP_BACKOFF_BASE=1.0

# ── LLM Resilience ──────────────────────────────────────
# Timeout in seconds for a single LLM call (also sets ANTHROPIC_TIMEOUT)
# LLM_TIMEOUT_SECONDS=600
# Max retries for failed LLM calls
# LLM_MAX_RETRIES=3
# Max retries for Anthropic SDK (overcommit, rate limit, etc.)
# ANTHROPIC_MAX_RETRIES=3

# ── Observability ────────────────────────────────────────
# Logs directory path
# LOG_DIR=logs
# Max size in bytes per log file before rotation (default 10 MB)
# LOG_MAX_BYTES=10485760
# Number of rotated log backups to keep
# LOG_BACKUP_COUNT=5
